## Aplicação
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

## Domínios, Portas e Permissões
PUBLIC_APP_PORT=5000
APP_URL=http://localhost:${PUBLIC_APP_PORT}
APP_STORAGE_URL=${APP_URL}/storage
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000

## Banco de Dados
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=