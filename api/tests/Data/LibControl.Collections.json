    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                    "// Guarda XSRF-TOKEN e laravel-session de uma resposta nas variáveis da collection.",
                    "const capturarCredenciais = (headers) => {",
                    "    const alvos = {",
                    "        'XSRF-TOKEN': 'xsrfToken',",
                    "        'laravel-session': 'laravelSession',",
                    "    };",
                    "",
                    "    headers.all()",
                    "        .filter(h => h.key.toLowerCase() === 'set-cookie')",
                    "        .forEach(h => {",
                    "            const [par] = h.value.split(';');",
                    "            const idx = par.indexOf('=');",
                    "            const nome = par.slice(0, idx).trim();",
                    "            const valor = par.slice(idx + 1).trim();",
                    "",
                    "            if (!alvos[nome]) return;",
                    "",
                    "            // O header X-XSRF-TOKEN precisa do valor decodificado (o cookie vem URL-encoded)",
                    "            const final = nome === 'XSRF-TOKEN' ? decodeURIComponent(valor) : valor;",
                    "            pm.collectionVariables.set(alvos[nome], final);",
                    "            console.log(`[auth] ${alvos[nome]} atualizado`);",
                    "        });",
                    "};",
                    "",
                    "// Injeta os headers que o Sanctum precisa para tratar a requisição como stateful.",
                    "const aplicarCredenciais = () => {",
                    "    const xsrfToken = pm.collectionVariables.get('xsrfToken');",
                    "    const laravelSession = pm.collectionVariables.get('laravelSession');",
                    "",
                    "    if (xsrfToken) {",
                    "        pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrfToken });",
                    "    }",
                    "",
                    "    if (laravelSession) {",
                    "        pm.request.headers.upsert({ key: 'Cookie', value: `laravel-session=${laravelSession}` });",
                    "    }",
                    "};",
                    "",
                    "const url = pm.variables.replaceIn(pm.request.url.toString());",
                    "const origem = (url.match(/^https?:\\/\\/[^\\/]+/) || [])[0];",
                    "",
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
                    "",
                    "if (origem) {",
                    "    pm.request.headers.upsert({ key: 'Origin', value: origem });",
                    "}",
                    "",
                    "// Sem credenciais (primeiro uso, após 419 ou expiração): busca o cookie CSRF antes de seguir",
                    "const precisaCsrf = !pm.collectionVariables.get('xsrfToken')",
                    "    && origem",
                    "    && !url.includes('/sanctum/csrf-cookie');",
                    "",
                    "if (precisaCsrf) {",
                    "    pm.sendRequest({",
                    "        url: `${origem}/sanctum/csrf-cookie`,",
                    "        method: 'GET',",
                    "        header: { Origin: origem, Accept: 'application/json' },",
                    "    }, (erro, resposta) => {",
                    "        if (erro) {",
                    "            console.error('[auth] falha ao obter o cookie CSRF', erro);",
                    "            return;",
                    "        }",
                    "",
                    "        capturarCredenciais(resposta.headers);",
                    "        aplicarCredenciais();",
                    "    });",
                    "} else {",
                    "    aplicarCredenciais();",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                    "// Guarda XSRF-TOKEN e laravel-session de uma resposta nas variáveis da collection.",
                    "const capturarCredenciais = (headers) => {",
                    "    const alvos = {",
                    "        'XSRF-TOKEN': 'xsrfToken',",
                    "        'laravel-session': 'laravelSession',",
                    "    };",
                    "",
                    "    headers.all()",
                    "        .filter(h => h.key.toLowerCase() === 'set-cookie')",
                    "        .forEach(h => {",
                    "            const [par] = h.value.split(';');",
                    "            const idx = par.indexOf('=');",
                    "            const nome = par.slice(0, idx).trim();",
                    "            const valor = par.slice(idx + 1).trim();",
                    "",
                    "            if (!alvos[nome]) return;",
                    "",
                    "            // O header X-XSRF-TOKEN precisa do valor decodificado (o cookie vem URL-encoded)",
                    "            const final = nome === 'XSRF-TOKEN' ? decodeURIComponent(valor) : valor;",
                    "            pm.collectionVariables.set(alvos[nome], final);",
                    "            console.log(`[auth] ${alvos[nome]} atualizado`);",
                    "        });",
                    "};",
                    "",
                    "// Captura as credenciais de toda resposta (login, registro e logout regeneram a sessão)",
                    "capturarCredenciais(pm.response.headers);",
                    "",
                    "// 419: token CSRF não bate com a sessão. Limpa tudo para a próxima requisição renovar.",
                    "if (pm.response.code === 419) {",
                    "    pm.collectionVariables.set('xsrfToken', '');",
                    "    pm.collectionVariables.set('laravelSession', '');",
                    "    console.warn('[auth] token CSRF inválido; será renovado na próxima requisição');",
                    "}",
                    "",
                    "if (pm.response.code === 401) {",
                    "    console.warn('[auth] sessão não autenticada; execute Auth > Login');",
                    "}"
                ]
            }
        }
